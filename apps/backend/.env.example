# Local defaults match `make dev-up`. Use your own secrets for deployments.
APP_JWT_SECRET=logify-local-development-secret-change-me
APP_SERVER_PORT=:8080

APP_POSTGRES_HOST=localhost
APP_POSTGRES_PORT=5432
APP_POSTGRES_DATABASE=logify
APP_POSTGRES_USER=postgres
APP_POSTGRES_PASSWORD=postgres

APP_KAFKA_BROKERS=localhost:29092
APP_CLICKHOUSE_HOST=localhost
APP_CLICKHOUSE_PORT=9000
APP_CLICKHOUSE_DATABASE=logify
APP_CLICKHOUSE_USER=default
APP_CLICKHOUSE_PASSWORD=mypassword
